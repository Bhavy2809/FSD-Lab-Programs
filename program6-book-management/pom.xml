<?xml version="1.0" encoding="UTF-8"?>
<!--
  Program 6: Book Management Application - Spring Boot and Thymeleaf
  (Bhavy Shukla, 1NT23CS042)

  THINGS TO INSTALL (one time)
    1. JDK 17 or newer          ->  check:  java -version
    2. Apache Maven 3.9+        ->  check:  mvn -v
    Spring Boot, Spring MVC, Thymeleaf and the embedded Tomcat server are
    downloaded automatically by Maven from this pom.xml.

  STEPS TO EXECUTE (terminal, inside this folder)
    1. cd program6-book-management
    2. mvn spring-boot:run
    3. Wait for "Tomcat started on port 8080", then open
         http://localhost:8080          (redirects to /books)
    4. Stop with Ctrl + C

  If port 8080 is busy, change the port: see "Common problems" in the root README.md.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.5</version>
        <relativePath/>
    </parent>

    <groupId>com.nmit</groupId>
    <artifactId>bookapp</artifactId>
    <version>1.0.0</version>

    <name>Book Management Application</name>
    <description>Book Management using Spring Boot and Thymeleaf</description>

    <properties>
        <java.version>17</java.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-thymeleaf</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
